Window.SetBackgroundTopColor(0.02, 0.03, 0.05);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);

logo.image = Image("vantaos-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

message = Sprite();
message.SetPosition(Window.GetWidth() / 2, Window.GetHeight() * 0.70, 10000);

fun refresh_callback() {
  progress = Plymouth.GetBootProgress();
  opacity = 0.45 + Math.Sin(progress * 6.28) * 0.20;
  logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
